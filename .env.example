HOME_DATA_DIR=/home/benjamin/apps/homeapp-data
HOME_SECRET_KEY=changeme-generate-a-real-one

# Needed so "link an existing workspace" can show users a real remote URL
# to push/pull against (ssh://HOME_GIT_SSH_USER@HOME_GIT_HOST/path/to.git).
# HOME_GIT_HOST is your server's SSH-reachable address (domain or IP);
# HOME_GIT_SSH_USER is the OS user account that owns HOME_DATA_DIR (defaults
# to whoever ran the installer if unset).
#
# Don't hand-edit this in on the server — pass it to the install command
# instead, and the installer will add it for you:
#   HOME_GIT_HOST=home.example.com curl -fsSL .../install.sh | bash
HOME_GIT_HOST=home.example.com
HOME_GIT_SSH_USER=benjamin
