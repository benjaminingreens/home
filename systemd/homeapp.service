[Unit]
Description=HOME personal OS (homeapp)
After=network.target

[Service]
Type=simple
User=benjamin
Group=benjamin
WorkingDirectory=/home/benjamin/apps/homeapp
EnvironmentFile=/home/benjamin/apps/homeapp/.env
ExecStart=/home/benjamin/apps/homeapp/.venv/bin/gunicorn -w 4 -b 127.0.0.1:8001 wsgi:app
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/benjamin/apps/homeapp-data

[Install]
WantedBy=multi-user.target
